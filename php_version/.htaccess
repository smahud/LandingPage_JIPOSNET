# ===========================================================================
# JIPOSNET — konfigurasi Apache untuk shared hosting / cPanel
# Aktif otomatis di mayoritas hosting berbasis Apache/LiteSpeed.
# ===========================================================================

# Dokumen default
DirectoryIndex index.php index.html

# ── Kompresi (mempercepat loading) ─────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# ── Cache browser ──────────────────────────────────────────────────────────
# File aset diberi nama tetap → cache panjang. HTML selalu segar.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html                 "access plus 0 seconds"
    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

# ── Keamanan ringan ────────────────────────────────────────────────────────
# Sembunyikan daftar isi direktori
Options -Indexes

# Blokir akses langsung ke file internal
<FilesMatch "^(config\.php|helpers\.php|icons\.php)$">
    Require all denied
</FilesMatch>

# Header keamanan dasar
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
